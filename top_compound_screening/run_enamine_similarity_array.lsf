#!/bin/bash

#BSUB -J "enamine_sim[1-64]%32"
#BSUB -q short
#BSUB -W 8:00
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16000]"
#BSUB -oo /path/to/logs/similarity_%I.out
#BSUB -eo /path/to/logs/similarity_%I.err

set -euo pipefail


# ============================================================
# Configuration
# ============================================================

MANIFEST="/path/to/enamine_90b_manifest.txt"

SCRIPT="/path/to/search_enamine_similarity_worker.py"

QUERY_SMILES='YOUR_REFERENCE_SMILES_HERE'

TOP_K=1000000

TASK_COUNT=64

WORKERS=8

BATCH_SIZE=50000


# Persistent output.
#
# These files MUST survive after an LSF job ends.
RESULT_DIR="/path/to/similarity_results/query_01/shards"


# Temporary node-local work.
WORK_DIR="/scratch/${USER}/enamine_similarity_${LSB_JOBID}"


# ============================================================
# Environment
# ============================================================

# Modify for your RDKit environment if needed:
#
# source ~/miniconda3/etc/profile.d/conda.sh
# conda activate rdkit


mkdir -p "$RESULT_DIR"
mkdir -p "$WORK_DIR"


echo "============================================================"
echo "Enamine distributed similarity search"
echo "============================================================"
echo "LSF Job ID:      ${LSB_JOBID}"
echo "LSF array index: ${LSB_JOBINDEX}"
echo "Host:            $(hostname)"
echo "Allocated CPUs:  ${LSB_DJOB_NUMPROC:-unknown}"
echo
echo "Task count:      ${TASK_COUNT}"
echo "Workers/job:     ${WORKERS}"
echo "Top K:           ${TOP_K}"
echo "Batch size:      ${BATCH_SIZE}"
echo "============================================================"


python "$SCRIPT" \
    --manifest "$MANIFEST" \
    --query-smiles "$QUERY_SMILES" \
    --top-k "$TOP_K" \
    --task-count "$TASK_COUNT" \
    --workers "$WORKERS" \
    --batch-size "$BATCH_SIZE" \
    --header-lines 1 \
    --radius 2 \
    --fp-size 2048 \
    --work-dir "$WORK_DIR" \
    --output-dir "$RESULT_DIR"


echo
echo "Similarity shard completed successfully."


# Cleanup node-local scratch.
rm -rf "$WORK_DIR"
